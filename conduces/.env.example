# =====================================================================
# Sistema de Conduces — variables de entorno
# Copiar a .env.local (desarrollo) o .env (docker compose) y completar.
# NUNCA subir .env / .env.local a Git. Nunca poner valores reales aquí ni en la documentación.
# =====================================================================

# --- Base de datos (SECRETAS: solo servidor) ---
# Conexión de la APLICACIÓN con el rol conduces_app (sin BYPASSRLS, sin permisos de dueño).
# Formato: postgresql://conduces_app:CONTRASEÑA@HOST:5432/conduces
DATABASE_URL=
# Conexión con el rol DUEÑO del esquema (conduces_owner): solo para migraciones, respaldos y scripts
# administrativos (npm run db:migrate, npm run backup, npm run create-admin). La aplicación no la usa.
# Formato: postgresql://conduces_owner:CONTRASEÑA@HOST:5432/conduces
DATABASE_OWNER_URL=

# --- Docker Compose (solo al levantar la BD con docker compose) ---
# Contraseña del superusuario "postgres" del contenedor y de los roles creados por db/bootstrap.sql.
POSTGRES_PASSWORD=
CONDUCES_OWNER_PASSWORD=
CONDUCES_APP_PASSWORD=

# --- Sesiones (SECRETA) ---
# Cadena aleatoria de al menos 32 caracteres. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# --- Aplicación ---
# URL con la que los usuarios abren el sistema (p. ej. https://conduces.local o la del túnel).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Zona horaria del negocio (dashboard "hoy/semana/mes", fechas por defecto).
APP_TIMEZONE=America/Santo_Domingo
# Tamaño máximo por archivo de importación, en MB.
IMPORT_MAX_FILE_MB=10
# Nivel de logs del servidor: debug | info | warn | error
LOG_LEVEL=info

# --- Respaldos (opcional) ---
# Carpeta donde el contenedor/script de respaldo deja los .dump (fuera del repositorio).
BACKUP_DIR=./backups
# Días de respaldos diarios a conservar.
BACKUP_RETENTION_DAYS=30
# Destino rclone opcional para copia fuera del equipo (p. ej. "gdrive:conduces-backups"). Vacío = desactivado.
BACKUP_RCLONE_REMOTE=

# --- Solo pruebas (local/CI) ---
# Superusuario de un PostgreSQL local desechable. `npm run test:db` crea y BORRA bases temporales con él.
# Ejemplo: postgresql://postgres:postgres@localhost:5432/postgres
TEST_DATABASE_ADMIN_URL=
