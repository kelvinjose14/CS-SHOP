# =====================================================================
# Sistema de Conduces — variables de entorno
# Copiar a .env.local y completar. NUNCA subir .env / .env.local a Git.
# Nunca poner valores reales en este archivo ni en la documentación.
# =====================================================================

# --- Supabase (públicas: llegan al navegador; la seguridad real es RLS) ---
# URL del proyecto. Local: la imprime `npx supabase start`. Nube: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública "anon" / "publishable". Solo permite lo que RLS autoriza al usuario con sesión.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (SECRETA: solo servidor, nunca con prefijo NEXT_PUBLIC_) ---
# Clave service_role / secret. Salta RLS. Se usa solo en src/server/** para crear usuarios,
# subir/leer archivos de importación y scripts administrativos.
SUPABASE_SERVICE_ROLE_KEY=

# --- Conexión directa a PostgreSQL (SECRETA: solo servidor/scripts) ---
# Para migraciones, backups (pg_dump) y scripts. Usar la conexión directa (no el pooler) para pg_dump.
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:5432/postgres
DATABASE_URL=

# --- Aplicación ---
# URL pública de la app (enlaces de invitación/recuperación de contraseña).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Zona horaria del negocio (dashboard "hoy/semana/mes", fechas por defecto).
APP_TIMEZONE=America/Santo_Domingo
# Tamaño máximo por archivo de importación, en MB.
IMPORT_MAX_FILE_MB=10
# Nivel de logs del servidor: debug | info | warn | error
LOG_LEVEL=info

# --- Solo pruebas (local/CI) ---
# PostgreSQL desechable para `npm run test:db`. Se BORRA y recrea en cada ejecución.
# Ejemplo local: postgresql://postgres:postgres@localhost:5432/conduces_test
TEST_DATABASE_URL=
