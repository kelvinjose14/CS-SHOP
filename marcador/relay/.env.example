# Configuración privada del intermediario. Copia este archivo como .env
# (o ejecuta `npm run configurar`). El .env NO se sube a git.

# YouTube Studio → Emitir en vivo → Configuración de la emisión → Clave de transmisión
YOUTUBE_STREAM_KEY=
# Servidor de YouTube por RTMPS (no hace falta cambiarlo)
YOUTUBE_INGEST_URL=rtmps://a.rtmps.youtube.com/live2

# Correos que pueden transmitir con este intermediario (separados por comas)
ALLOWED_EMAILS=

# Dirección pública del marcador (Vercel)
STUDIO_URL=https://marcador-one.vercel.app

# Supabase: URL y clave PÚBLICA (las mismas de Vercel). Sirven para comprobar tu sesión.
SUPABASE_URL=https://tqynzscirvqrhzmpkhdq.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_79VibK1hEoc2qUSYyzFBtQ_iIXL1j3A

# Puerto local y túnel gratuito de Cloudflare (quick = sin cuenta; off = sin túnel)
PORT=8787
TUNNEL=quick
