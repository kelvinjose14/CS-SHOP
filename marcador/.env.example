# Copia este archivo como .env.local (en local) o crea estas variables en Vercel.
# Paso a paso en el README, sección 2.

# URL del proyecto de Supabase.
# Dónde: panel de Supabase → botón "Connect" (arriba) → pestaña "App Frameworks" → Next.js,
#        o Project Settings → Data API → "Project URL".
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave PÚBLICA (empieza con sb_publishable_). También sirve la "anon" antigua (eyJ...).
# Dónde: Project Settings → API Keys → "Publishable key".
# NUNCA pongas aquí la "secret" (sb_secret_...) ni la "service_role": la app se niega a arrancar si lo haces.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
